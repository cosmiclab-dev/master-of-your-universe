# Master of Your Universe: photo keys
# Keep this file on your Desktop. Paste a key after the = sign, save, then start the game.
# It never leaves this computer: the game's local server reads it and adds the key to requests.

# Free: Cloudflare Workers AI (about 170 photos a day)
# Account ID: dash.cloudflare.com > Workers AI (right side, "Account ID")
# Token: My Profile > API Tokens > Create Token > "Workers AI" template
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Best quality for the client demo (needs billing on in Google AI Studio)
GEMINI_API_KEY=

# Optional
OPENAI_API_KEY=
FAL_KEY=
UNSLOTH_API_KEY=
